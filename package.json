{
  "name": "insuredmine-assessment",
  "version": "1.0.0",
  "description": "InsuredMine Node.js technical assessment - CSV/XLSX to MongoDB ingestion, search, aggregation, CPU-based restart and scheduled messaging",
  "main": "src/cluster.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/cluster.js",
    "start:single": "node src/server.js",
    "dev": "nodemon src/server.js",
    "mongo:dev": "node scripts/startMemoryMongo.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:watch": "cross-env NODE_ENV=test jest --runInBand --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\""
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "worker-threads",
    "assessment"
  ],
  "author": "Kishore",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
